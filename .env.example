POSTGRES_DB=solidarity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-random-secret-with-at-least-32-characters
BACKEND_PORT=3000
FRONTEND_PORT=4200
CORS_ORIGIN=http://localhost:4200,https://solidarity-network.rhuanpasti.workers.dev,https://solidarity-network-live.web.app
NODE_ENV=development
TRUST_PROXY=false
APP_PUBLIC_URL=http://localhost:4200
PASSWORD_RESET_PATH=/reset-password
BREVO_ENABLED=false
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Solidarity Network

# Demo mode keeps the demo account and all demo records out of the database.
DEMO_MODE=false
DEMO_USER_USERNAME=demo-user
DEMO_USER_EMAIL=demo@solidarity-network.local
DEMO_USER_PASSWORD=demo-user-2026

# Optional demo/bootstrap credentials. Never use these for production data.
SEED_ADMIN_EMAIL=admin@solidarity-network.local
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
DEMO_SEED_ENABLED=false
DEMO_SEED_ALLOW_PRODUCTION=false
