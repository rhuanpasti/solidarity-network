{
  "name": "@solidarity-network/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prestart:dev": "npm --prefix ../../packages/shared run build",
    "prebuild": "npm --prefix ../../packages/shared run build",
    "prestart": "npm run build",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "nest build",
    "test": "npm --prefix ../../packages/shared run build && tsx test/index.ts",
    "email:test": "tsx test/sendpulse-email.live.ts",
    "start": "node dist/src/main.js",
    "start:prod": "prisma migrate deploy && node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.1",
    "@prisma/client": "^6.19.2",
    "@solidarity-network/shared": "file:../../packages/shared",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sendpulse-api": "^1.1.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "prisma": "6.19.2",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
