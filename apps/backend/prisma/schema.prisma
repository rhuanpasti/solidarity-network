generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CharityProgramStatus {
  active
  inactive
}

enum AdministratorRole {
  super_admin
  program_manager
  case_worker
}

enum BeneficiaryStatus {
  active
  inactive
  archived
}

enum BenefitCategory {
  food
  hygiene
  financial
  education
  clothing
  medicine
  other
}

model CharityProgram {
  id                 String                     @id @default(cuid())
  name               String
  description        String
  status             CharityProgramStatus       @default(active)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  administrators     AdministratorProgramLink[]
  beneficiaries      BeneficiaryProgramLink[]
  benefitDeliveries  BenefitDelivery[]
}

model Administrator {
  id                String                     @id @default(cuid())
  name              String
  email             String                     @unique
  phone             String
  role              AdministratorRole
  isSystemRoot      Boolean                    @default(false)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  credential        AuthCredential?
  charityPrograms   AdministratorProgramLink[]
  benefitDeliveries BenefitDelivery[]
}

model AuthCredential {
  id                    String        @id @default(cuid())
  administratorId       String        @unique
  username              String        @unique
  passwordHash          String
  mustChangePassword    Boolean       @default(true)
  lastPasswordChangedAt DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  administrator         Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)
}

model AdministratorProgramLink {
  administratorId String
  charityProgramId String
  createdAt       DateTime @default(now())

  administrator   Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)
  charityProgram  CharityProgram @relation(fields: [charityProgramId], references: [id], onDelete: Cascade)

  @@id([administratorId, charityProgramId])
}

model Beneficiary {
  id               String              @id @default(cuid())
  fullName         String
  document         String              @unique
  birthDate        DateTime?
  email            String?             @unique
  phone            String
  passwordHash     String?
  mustChangePassword Boolean           @default(true)
  lastPasswordChangedAt DateTime?
  address          Json
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  status           BeneficiaryStatus   @default(active)

  charityPrograms  BeneficiaryProgramLink[]
  benefitDeliveries BenefitDelivery[]

  @@index([status])
  @@index([fullName])
}

model BeneficiaryProgramLink {
  beneficiaryId   String
  charityProgramId String
  createdAt       DateTime @default(now())

  beneficiary     Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)
  charityProgram  CharityProgram @relation(fields: [charityProgramId], references: [id], onDelete: Cascade)

  @@id([beneficiaryId, charityProgramId])
  @@index([charityProgramId])
}

model Benefit {
  id               String            @id @default(cuid())
  name             String
  description      String
  category         BenefitCategory
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  benefitDeliveries BenefitDelivery[]
}

model BenefitDelivery {
  id               String         @id @default(cuid())
  beneficiaryId    String
  benefitId        String
  charityProgramId String
  quantity         Int
  deliveryDate     DateTime
  notes            String?
  administratorId  String
  reference        String         @unique
  createdAt        DateTime       @default(now())

  beneficiary      Beneficiary    @relation(fields: [beneficiaryId], references: [id])
  benefit          Benefit        @relation(fields: [benefitId], references: [id])
  charityProgram   CharityProgram @relation(fields: [charityProgramId], references: [id])
  administrator    Administrator  @relation(fields: [administratorId], references: [id])

  @@index([beneficiaryId])
  @@index([charityProgramId])
  @@index([deliveryDate])
}

model AuditTrail {
  id               String   @id @default(cuid())
  action           String
  status           String
  entityType       String?
  entityId         String?
  charityProgramId String?
  actorAccountId   String?
  actorAccountType String?
  actorRole        String?
  requestId        String?
  ipAddress        String?
  userAgent        String?
  changedFields    String[] @default([])
  previousValues   Json?
  newValues        Json?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([action])
  @@index([status])
  @@index([entityType, entityId])
  @@index([actorAccountId, actorAccountType])
  @@index([charityProgramId])
  @@index([requestId])
  @@index([createdAt])
}
