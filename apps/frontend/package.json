{
  "name": "@solidarity-network/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prestart": "npm --prefix ../../packages/shared run build",
    "prebuild": "npm --prefix ../../packages/shared run build",
    "start": "ng serve",
    "build": "ng build",
