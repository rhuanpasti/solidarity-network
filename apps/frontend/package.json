{
  "name": "@solidarity-network/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prestart": "npm --prefix ../../packages/shared run build",
    "start": "ng serve",
    "build": "npm run lint && npm --prefix ../../packages/shared run build && ng build",
    "lint": "eslint . --cache --max-warnings=0",
    "lint:fix": "eslint . --cache --fix",
    "deploy:firebase": "npm run build && firebase deploy --only hosting",
    "deploy:workers": "npx wrangler deploy",
    "test": "npm --prefix ../../packages/shared run build && tsx test/index.ts"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@solidarity-network/shared": "file:../../packages/shared",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.1",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
