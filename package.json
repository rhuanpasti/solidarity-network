{
  "name": "solidarity-network",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "start:frontend": "npm --prefix apps/frontend run start",
    "start:backend": "npm --prefix apps/backend run start:dev",
    "seed:backend": "npm --prefix apps/backend run prisma:seed",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm --prefix apps/frontend run build",
    "build:backend": "npm --prefix apps/backend run build",
    "build:shared": "npm --prefix packages/shared run build",
    "lint:frontend": "npm --prefix apps/frontend run lint",
    "lint:backend": "npm --prefix apps/backend run lint",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "test:frontend": "npm --prefix apps/frontend run test",
    "test:backend": "npm --prefix apps/backend run test",
    "test:coverage": "npm run test:coverage:backend && npm run test:coverage:frontend",
    "test:coverage:backend": "npm --prefix apps/backend run test:coverage",
    "test:coverage:frontend": "npm --prefix apps/frontend run test:coverage",
    "test": "npm run test:backend && npm run test:frontend",
    "deploy:frontend:workers": "npx wrangler deploy --config apps/frontend/wrangler.jsonc"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "c8": "^12.0.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3"
  }
}
