{
  "name": "solidarity-network",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "start:frontend": "npm --prefix apps/frontend run start",
    "start:backend": "npm --prefix apps/backend run start:dev",
    "build:frontend": "npm --prefix apps/frontend run build",
    "build:backend": "npm --prefix apps/backend run build",
    "build:shared": "npm --prefix packages/shared run build",
    "test:frontend": "npm --prefix apps/frontend run test",
    "test:backend": "npm --prefix apps/backend run test",
    "test": "npm run test:backend && npm run test:frontend",
    "deploy:frontend:workers": "npx wrangler deploy --config apps/frontend/wrangler.jsonc"
  }
}
