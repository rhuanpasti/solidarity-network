# Select the target used by the Playwright commands.
E2E_TARGET=local

# Local frontend/backend.
E2E_LOCAL_BASE_URL=http://localhost:4200
E2E_LOCAL_API_BASE_URL=http://localhost:3000/api/v1

# Published frontend/backend. Set these to the actual public deployment URLs.
E2E_PUBLISHED_BASE_URL=https://solidarity-network-live.web.app
E2E_PUBLISHED_API_BASE_URL=https://solidarity-network.onrender.com/api/v1

# Credentials are target-specific when local and published accounts differ.
# The unscoped E2E_ADMIN_* names are accepted as a fallback for both targets.
E2E_LOCAL_ADMIN_IDENTIFIER=
E2E_LOCAL_ADMIN_PASSWORD=
E2E_PUBLISHED_ADMIN_IDENTIFIER=
E2E_PUBLISHED_ADMIN_PASSWORD=
E2E_ADMIN_IDENTIFIER=
E2E_ADMIN_PASSWORD=

# Optional additional accounts for future scoped authorization specs.
E2E_LOCAL_PROGRAM_MANAGER_IDENTIFIER=
E2E_LOCAL_PROGRAM_MANAGER_PASSWORD=
E2E_PUBLISHED_PROGRAM_MANAGER_IDENTIFIER=
E2E_PUBLISHED_PROGRAM_MANAGER_PASSWORD=
E2E_PROGRAM_MANAGER_IDENTIFIER=
E2E_PROGRAM_MANAGER_PASSWORD=

E2E_LOCAL_BENEFICIARY_IDENTIFIER=
E2E_LOCAL_BENEFICIARY_PASSWORD=
E2E_PUBLISHED_BENEFICIARY_IDENTIFIER=
E2E_PUBLISHED_BENEFICIARY_PASSWORD=
E2E_BENEFICIARY_IDENTIFIER=
E2E_BENEFICIARY_PASSWORD=
